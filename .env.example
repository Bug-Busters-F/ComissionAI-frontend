# Configuração da API do Spring Boot
# Com o proxy configurado no vite.config.js, as chamadas para /api/v1 são redirecionadas
# para http://localhost:8080/api/v1 sem problemas de CORS no navegador.
VITE_API_URL=/api/v1

# Nova criação com múltiplas propostas: manual | demo | api
VITE_CAMPAIGN_PROPOSALS_MODE=manual

# Para integrar o formulário multirregras ao backend disponível:
# VITE_CAMPAIGN_PROPOSALS_MODE=api
# O navegador usa apenas VITE_API_URL; as credenciais da IA ficam no servidor.
# Reinicie o Vite após trocar o modo. Em api: rascunho, simulação, aceite e ativação reais.
# O backend em execução precisa conter os endpoints atuais de simulação e ativação.

# Acesso real exige backend com autenticação (PR #33).
# Destino do proxy de desenvolvimento; não contém credenciais.
VITE_BACKEND_URL=http://127.0.0.1:8080
# Exemplo local da esteira (não representa decisões reais); desligado por padrão.
VITE_ENABLE_WORKFLOW_PREVIEW=false
